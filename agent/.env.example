# Network the franchise contract lives on: testnet or mainnet
NEAR_NETWORK=testnet
# Optional: override the RPC endpoint
# NEAR_RPC_URL=https://test.rpc.fastnear.com
# The deployed franchise contract
FRANCHISE_CONTRACT=franchise.your-account.testnet
# Hosted mode: derive every agent's operator key from one secret, so the runtime keeps
# no files and survives restarts. Generate with: openssl rand -hex 32. Keep it secret.
# OPERATOR_MASTER_SEED=
# Local mode (no seed): random keys stored here by `npm run keygen`. Never commit it.
OPERATOR_KEYS_FILE=.operators.json

# LLM: "nearai" uses NEAR AI Cloud (private inference in a TEE), "mock" answers with a
# labelled canned reply, "auto" uses nearai when NEARAI_API_KEY is set, mock otherwise.
# "scripted" delivers SCRIPTED_ANSWER verbatim, labelled "scripted demo answer, no AI model called".
LLM_MODE=auto
NEARAI_API_KEY=
NEARAI_MODEL=Qwen/Qwen3.6-35B-A3B-FP8
# Reasoning models otherwise spend the token budget thinking; "none" turns that off.
NEARAI_REASONING=none
POLL_MS=4000
# Set to serve GET /operator/<token_id> so holders can activate this runtime from the web app
# PORT=8787
